# ICT Platform Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# WordPress Configuration
# =============================================================================
DB_NAME=wordpress_db
DB_USER=wordpress_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PREFIX=wp_

# WordPress salts and keys - generate unique values at:
# https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# =============================================================================
# Zoho CRM Integration
# =============================================================================
ICT_ZOHO_CRM_CLIENT_ID=
ICT_ZOHO_CRM_CLIENT_SECRET=
ICT_ZOHO_CRM_REFRESH_TOKEN=
ICT_ZOHO_CRM_WEBHOOK_SECRET=

# =============================================================================
# Zoho FSM (Field Service Management) Integration
# =============================================================================
ICT_ZOHO_FSM_CLIENT_ID=
ICT_ZOHO_FSM_CLIENT_SECRET=
ICT_ZOHO_FSM_REFRESH_TOKEN=
ICT_ZOHO_FSM_WEBHOOK_SECRET=

# =============================================================================
# Zoho Books Integration
# =============================================================================
ICT_ZOHO_BOOKS_CLIENT_ID=
ICT_ZOHO_BOOKS_CLIENT_SECRET=
ICT_ZOHO_BOOKS_REFRESH_TOKEN=
ICT_ZOHO_BOOKS_WEBHOOK_SECRET=

# =============================================================================
# Zoho People Integration
# =============================================================================
ICT_ZOHO_PEOPLE_CLIENT_ID=
ICT_ZOHO_PEOPLE_CLIENT_SECRET=
ICT_ZOHO_PEOPLE_REFRESH_TOKEN=
ICT_ZOHO_PEOPLE_WEBHOOK_SECRET=

# =============================================================================
# Zoho Desk Integration
# =============================================================================
ICT_ZOHO_DESK_CLIENT_ID=
ICT_ZOHO_DESK_CLIENT_SECRET=
ICT_ZOHO_DESK_REFRESH_TOKEN=
ICT_ZOHO_DESK_WEBHOOK_SECRET=

# =============================================================================
# QuoteWerks Integration
# =============================================================================
ICT_QUOTEWERKS_API_KEY=
ICT_QUOTEWERKS_API_URL=
ICT_QUOTEWERKS_WEBHOOK_SECRET=

# =============================================================================
# Microsoft Teams Integration
# =============================================================================
ICT_TEAMS_WEBHOOK_URL=
ICT_TEAMS_CLIENT_ID=
ICT_TEAMS_CLIENT_SECRET=
ICT_TEAMS_TENANT_ID=

# =============================================================================
# Google Maps API (for GPS tracking and location features)
# =============================================================================
# IMPORTANT: Restrict this key to your domain in Google Cloud Console
ICT_GOOGLE_MAPS_API_KEY=

# =============================================================================
# Push Notifications (Firebase Cloud Messaging)
# =============================================================================
ICT_FCM_SERVER_KEY=
ICT_VAPID_PUBLIC_KEY=
ICT_VAPID_PRIVATE_KEY=

# =============================================================================
# Email Configuration
# =============================================================================
ICT_SMTP_HOST=smtp.example.com
ICT_SMTP_PORT=587
ICT_SMTP_USER=
ICT_SMTP_PASSWORD=
ICT_SMTP_FROM_EMAIL=noreply@example.com
ICT_SMTP_FROM_NAME="ICT Platform"

# =============================================================================
# Security & Encryption
# =============================================================================
# Generate a strong random key for encrypting sensitive data
# Use: openssl rand -base64 32
ICT_ENCRYPTION_KEY=

# JWT Token Configuration (for mobile app authentication)
ICT_JWT_SECRET=
ICT_JWT_EXPIRY=86400

# =============================================================================
# Application Settings
# =============================================================================
ICT_CURRENCY=USD
ICT_DATE_FORMAT=Y-m-d
ICT_TIME_FORMAT=H:i:s
ICT_TIMEZONE=America/New_York

# Project numbering
ICT_PROJECT_NUMBER_PREFIX=PRJ
ICT_PO_NUMBER_PREFIX=PO

# Time tracking
ICT_OVERTIME_THRESHOLD=8
ICT_TIME_ROUNDING_INTERVAL=15

# Sync settings
ICT_SYNC_INTERVAL=900
ICT_SYNC_BATCH_SIZE=20
ICT_SYNC_MAX_RETRIES=3

# Rate limiting
ICT_RATE_LIMIT_REQUESTS=60
ICT_RATE_LIMIT_WINDOW=60

# Push notification retention
ICT_PUSH_RETENTION_DAYS=30

# =============================================================================
# Development & Debugging
# =============================================================================
# Set to 'true' to enable debug mode (DO NOT use in production)
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false

# Environment type: development, staging, production
WP_ENVIRONMENT_TYPE=production

# =============================================================================
# External Services (Optional)
# =============================================================================
# Weather API (if using weather tracking features)
ICT_WEATHER_API_KEY=

# Twilio (if using SMS notifications)
ICT_TWILIO_ACCOUNT_SID=
ICT_TWILIO_AUTH_TOKEN=
ICT_TWILIO_FROM_NUMBER=

# Stripe (if using payment processing)
ICT_STRIPE_PUBLIC_KEY=
ICT_STRIPE_SECRET_KEY=
ICT_STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Notes
# =============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate API keys and secrets regularly
# 4. Use environment-specific values for development, staging, and production
# 5. Restrict API keys to specific domains/IPs where possible
# 6. Enable 2FA on all external service accounts
# 7. Monitor logs for unauthorized access attempts
